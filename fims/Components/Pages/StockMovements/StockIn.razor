@page "/stock-in"

<h2>Stock In</h2>

<div class="card">

    <div class="form-group">
        <label>Product</label>
        <select>
            <option>Select Product</option>
            <option>Rice</option>
            <option>Sugar</option>
            <option>Milk</option>
        </select>
    </div>

    <div class="form-group">
        <label>Quantity</label>
        <input type="number" />
    </div>

    <div class="form-group">
        <label>Supplier</label>
        <select>
            <option>Select Supplier</option>
            <option>Acme Foods</option>
            <option>Food Market</option>
        </select>
    </div>

    <div class="form-group">
        <label>Date</label>
        <input type="date" />
    </div>

    <div class="form-group">
        <label>Notes</label>
        <textarea rows="4"></textarea>
    </div>

    <button class="btn-save">
        Save Entry
    </button>

</div>