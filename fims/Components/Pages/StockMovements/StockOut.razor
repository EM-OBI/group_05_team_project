@page "/stock-out"
@rendermode InteractiveServer
@inject AppDbContext Db

<h2>Stock Out</h2>

@if (!string.IsNullOrEmpty(message))
{
    <div class="status-message @(isError ? "error" : "success")">@message</div>
}

<div class="card">

    <div class="form-group">
        <label>Product</label>
        <select @bind="selectedProductId">
            <option value="0">Select Product</option>
            @foreach (var p in products)
            {
                <option value="@p.ProductId">@p.Name (stock: @p.CurrentStockQuantity)</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label>Quantity</label>
        <input type="number" @bind="quantity" min="1" />
    </div>

    <div class="form-group">
        <label>Reason</label>
        <select @bind="reason">
            <option>Sale</option>
            <option>Damage</option>
            <option>Expired</option>
            <option>Adjustment</option>
        </select>
    </div>

    <div class="form-group">
        <label>Date</label>
        <input type="date" @bind="movementDate" />
    </div>

    <div class="form-group">
        <label>Notes</label>
        <textarea rows="4" @bind="notes"></textarea>
    </div>

    <button class="btn-save" @onclick="SaveStockOut">
        Save Exit
    </button>

</div>

@code {
    private List<Product> products = new();

    private int selectedProductId;
    private int quantity = 1;
    private string reason = "Sale";
    private DateTime movementDate = DateTime.Today;
    private string notes = string.Empty;
    private string message = string.Empty;
    private bool isError;

    protected override async Task OnInitializedAsync()
    {
        products = await Db.Products.ToListAsync();
    }

    private async Task SaveStockOut()
    {
        if (selectedProductId == 0)
        {
            message = "Please select a product.";
            isError = true;
            return;
        }

        if (quantity <= 0)
        {
            message = "Quantity must be at least 1.";
            isError = true;
            return;
        }

        try
        {
            var product = await Db.Products.FindAsync(selectedProductId);
            if (product == null)
            {
                message = "Product not found.";
                isError = true;
                return;
            }

            if (product.CurrentStockQuantity < quantity)
            {
                message = $"Insufficient stock. Available: {product.CurrentStockQuantity}";
                isError = true;
                return;
            }

            var movement = new StockMovement
            {
                ProductId = selectedProductId,
                Quantity = quantity,
                MovementType = MovementType.StockOut,
                MovementDate = movementDate
            };

            Db.StockMovements.Add(movement);
            product.CurrentStockQuantity -= quantity;

            await Db.SaveChangesAsync();

            message = $"Stock out recorded for {product.Name}. New quantity: {product.CurrentStockQuantity}";
            isError = false;

            selectedProductId = 0;
            quantity = 1;
            reason = "Sale";
            movementDate = DateTime.Today;
            notes = string.Empty;

            products = await Db.Products.ToListAsync();
        }
        catch (Exception ex)
        {
            message = $"Error: {ex.Message}";
            isError = true;
        }
    }
}
