@page "/stock-out"

<h2>Stock Out</h2>

<div class="card">

    <div class="form-group">
        <label>Product</label>
        <select>
            <option>Select Product</option>
            <option>Rice</option>
            <option>Sugar</option>
            <option>Milk</option>
        </select>
    </div>

    <div class="form-group">
        <label>Quantity</label>
        <input type="number" />
    </div>

    <div class="form-group">
        <label>Reason</label>
        <select>
            <option>Sale</option>
            <option>Damage</option>
            <option>Expired</option>
            <option>Adjustment</option>
        </select>
    </div>

    <div class="form-group">
        <label>Date</label>
        <input type="date" />
    </div>

    <div class="form-group">
        <label>Notes</label>
        <textarea rows="4"></textarea>
    </div>

    <button class="btn-save">
        Save Exit
    </button>

</div>