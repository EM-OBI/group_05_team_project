                    </td>
                </tr>

                <tr>
                    <td>Dairy</td>
                    <td>Milk and cheese</td>
                    <td>
                        <button>Edit</button>
                        <button>Delete</button>
                    </td>
                </tr>

                <tr>
                    <td>Grains</td>
                    <td>Rice and cereals</td>
                    <td>
                        <button>Edit</button>
                        <button>Delete</button>
                    </td>
                </tr>

            </tbody>

        </table>

    </section>

</div>
