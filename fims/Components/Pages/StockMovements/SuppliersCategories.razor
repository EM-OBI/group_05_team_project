@page "/suppliers-categories"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject AppDbContext Db

<h2>Suppliers & Categories</h2>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <div class="status-message @(statusIsError ? "error" : "success")">@statusMessage</div>
}

<div class="container">

    <!-- Suppliers -->

    <section class="panel">

        <div class="panel-header">
            <h3>Suppliers</h3>
            <button @onclick="ShowAddSupplier">Add Supplier</button>
        </div>

        @if (showSupplierForm)
        {
            <div class="form-card">
                <h4>@(formSupplierId == 0 ? "Add Supplier" : "Edit Supplier")</h4>
                <div class="form-group">
                    <label>Name</label>
                    <input type="text" @bind="formSupplierName" />
                </div>
                <div class="form-group">
                    <label>Contact Info</label>
                    <input type="text" @bind="formSupplierContact" placeholder="Phone, email, or address" />
                </div>
                <div class="form-buttons">
                    <button class="btn-cancel" @onclick="CancelSupplierForm">Cancel</button>
                    <button class="btn-save" @onclick="SaveSupplier">Save</button>
                </div>
            </div>
        }

        <table>

            <thead>
                <tr>
                    <th>Name</th>
                    <th>Contact Info</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var s in suppliers)
                {
                    <tr>
                        <td>@s.Name</td>
                        <td>@s.ContactInfo</td>
                        <td>
                            <button @onclick="() => EditSupplier(s)">Edit</button>

                    <!-- MODIFIED:
                    Instead of deleting immediately,
                    this button opens a confirmation dialog.
                    -->
                    <button @onclick="() => ConfirmDeleteSupplier(s)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </section>

    <!-- Categories -->

    <section class="panel">

        <div class="panel-header">
            <h3>Categories</h3>
            <button @onclick="ShowAddCategory">Add Category</button>
        </div>

        @if (showCategoryForm)
        {
            <div class="form-card">
                <h4>@(formCategoryId == 0 ? "Add Category" : "Edit Category")</h4>
                <div class="form-group">
                    <label>Name</label>
                    <input type="text" @bind="formCategoryName" />
                </div>
                <div class="form-buttons">
                    <button class="btn-cancel" @onclick="CancelCategoryForm">Cancel</button>
                    <button class="btn-save" @onclick="SaveCategory">Save</button>
                </div>
            </div>
        }

        <table>

            <thead>
                <tr>
                    <th>Name</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var c in categories)
                {
                    <tr>
                        <td>@c.Name</td>
                        <td>
                            <button @onclick="() => EditCategory(c)">Edit</button>
                            <!-- MODIFIED:
                    Instead of deleting immediately,
                    this button opens a confirmation dialog.
                    -->
                    <button @onclick="() => ConfirmDeleteCategory(c)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </section>

</div>


<!--
ADDED:
Confirmation dialog used before deleting
either a Supplier or a Category.
-->
@if (showDeleteDialog)
{
    <div class="modal-overlay">
        <div class="modal-box">

            <h3>Confirm Delete</h3>

            <p>
                Are you sure you want to delete
                <strong>@deleteItemName</strong>?
            </p>

            <p class="warning">
                This action cannot be undone.
            </p>

            <div class="modal-buttons">

                <button class="btn-cancel"
                        @onclick="CancelDelete">
                    Cancel
                </button>

                <button class="btn-delete"
                        @onclick="DeleteConfirmed">
                    Delete
                </button>

            </div>

        </div>
    </div>
}
@code {
    private List<Supplier> suppliers = new();
    private List<Category> categories = new();

    private int formSupplierId;
    private string formSupplierName = "";
    private string formSupplierContact = "";

    private int formCategoryId;
    private string formCategoryName = "";

    private bool showSupplierForm;
    private bool showCategoryForm;
    private string statusMessage = "";
    private bool statusIsError;
    private bool showDeleteDialog = false;
    private bool deletingSupplier;

    private Supplier? supplierToDelete;

    private Category? categoryToDelete;

private string deleteItemName = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        suppliers = await Db.Suppliers.ToListAsync();
        categories = await Db.Categories.ToListAsync();
    }

    private void ShowAddSupplier()
    {
        formSupplierId = 0;
        formSupplierName = "";
        formSupplierContact = "";
        showSupplierForm = true;
        statusMessage = "";
    }

    private void EditSupplier(Supplier s)
    {
        formSupplierId = s.SupplierId;
        formSupplierName = s.Name;
        formSupplierContact = s.ContactInfo;
        showSupplierForm = true;
        statusMessage = "";
    }

    private void CancelSupplierForm()
    {
        showSupplierForm = false;
        statusMessage = "";
    }

    private async Task SaveSupplier()
    {
        if (string.IsNullOrWhiteSpace(formSupplierName))
        {
            statusMessage = "Supplier name is required.";
            statusIsError = true;
            return;
        }

        try
        {
            if (formSupplierId == 0)
            {
                Db.Suppliers.Add(new Supplier
                {
                    Name = formSupplierName.Trim(),
                    ContactInfo = string.IsNullOrWhiteSpace(formSupplierContact) ? "" : formSupplierContact.Trim()
                });
            }
            else
            {
                var supplier = await Db.Suppliers.FindAsync(formSupplierId);
                if (supplier == null)
                {
                    statusMessage = "Supplier not found.";
                    statusIsError = true;
                    return;
                }
                supplier.Name = formSupplierName.Trim();
                supplier.ContactInfo = string.IsNullOrWhiteSpace(formSupplierContact) ? "" : formSupplierContact.Trim();
            }

            await Db.SaveChangesAsync();
            showSupplierForm = false;
            statusMessage = "Supplier saved successfully.";
            statusIsError = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            statusMessage = $"Error saving supplier: {ex.Message}";
            statusIsError = true;
        }
    }

   

    private void ShowAddCategory()
    {
        formCategoryId = 0;
        formCategoryName = "";
        showCategoryForm = true;
        statusMessage = "";
    }

    private void EditCategory(Category c)
    {
        formCategoryId = c.CategoryId;
        formCategoryName = c.Name;
        showCategoryForm = true;
        statusMessage = "";
    }

    private void CancelCategoryForm()
    {
        showCategoryForm = false;
        statusMessage = "";
    }

    // ==========================================================
// ADDED:
// Delete confirmation methods for Suppliers and Categories.
// ==========================================================

// Opens the confirmation dialog for deleting a supplier.
private void ConfirmDeleteSupplier(Supplier supplier)
{
    supplierToDelete = supplier;
    categoryToDelete = null;
    deletingSupplier = true;
    deleteItemName = supplier.Name;
    showDeleteDialog = true;
}

private void ConfirmDeleteCategory(Category category)
{
    categoryToDelete = category;
    supplierToDelete = null;
    deletingSupplier = false;
    deleteItemName = category.Name;
    showDeleteDialog = true;
}

private void CancelDelete()
{
    showDeleteDialog = false;
    supplierToDelete = null;
    categoryToDelete = null;
}

    private async Task SaveCategory()
    {
        if (string.IsNullOrWhiteSpace(formCategoryName))
        {
            statusMessage = "Category name is required.";
            statusIsError = true;
            return;
        }

        try
        {
            if (formCategoryId == 0)
            {
                Db.Categories.Add(new Category
                {
                    Name = formCategoryName.Trim()
                });
            }
            else
            {
                var category = await Db.Categories.FindAsync(formCategoryId);
                if (category == null)
                {
                    statusMessage = "Category not found.";
                    statusIsError = true;
                    return;
                }
                category.Name = formCategoryName.Trim();
            }

            await Db.SaveChangesAsync();
            showCategoryForm = false;
            statusMessage = "Category saved successfully.";
            statusIsError = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            statusMessage = $"Error saving category: {ex.Message}";
            statusIsError = true;
        }
    }

   // ==========================================================
// ADDED:
// Deletes the selected Supplier or Category only after
// the user confirms the action.
// ==========================================================
private async Task DeleteConfirmed()
{
    try
    {
        if (deletingSupplier && supplierToDelete != null)
        {
            var supplier = await Db.Suppliers.FindAsync(supplierToDelete.SupplierId);

            if (supplier != null)
            {
                Db.Suppliers.Remove(supplier);

                statusMessage = $"Deleted supplier '{supplier.Name}'.";
            }
        }
        else if (!deletingSupplier && categoryToDelete != null)
        {
            var category = await Db.Categories.FindAsync(categoryToDelete.CategoryId);

            if (category != null)
            {
                Db.Categories.Remove(category);

                statusMessage = $"Deleted category '{category.Name}'.";
            }
        }

        await Db.SaveChangesAsync();

        statusIsError = false;

        await LoadData();
    }
    catch (Exception ex)
    {
        statusMessage = $"Error deleting: {ex.Message}";
        statusIsError = true;
    }

    showDeleteDialog = false;
    supplierToDelete = null;
    categoryToDelete = null;
}
}
