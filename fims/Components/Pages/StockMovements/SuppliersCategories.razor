@page "/suppliers-categories"

<h2>Suppliers & Categories</h2>

<div class="container">

    <!-- Suppliers -->

    <section class="panel">

        <div class="panel-header">
            <h3>Suppliers</h3>
            <button>Add Supplier</button>
        </div>

        <table>

            <thead>
                <tr>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>

                <tr>
                    <td>Acme Foods</td>
                    <td>555-2211</td>
                    <td>sales@acme.com</td>
                    <td>
                        <button>Edit</button>
                        <button>Delete</button>
                    </td>
                </tr>

                <tr>
                    <td>Fresh Market</td>
                    <td>555-3344</td>
                    <td>info@fresh.com</td>
                    <td>
                        <button>Edit</button>
                        <button>Delete</button>
                    </td>
                </tr>

                <tr>
                    <td>Food Company</td>
                    <td>555-7788</td>
                    <td>contact@food.com</td>
                    <td>
                        <button>Edit</button>
                        <button>Delete</button>
                    </td>
                </tr>

            </tbody>

        </table>

    </section>

    <!-- Categories -->

    <section class="panel">

        <div class="panel-header">
            <h3>Categories</h3>
            <button>Add Category</button>
        </div>

        <table>

            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>

                <tr>
                    <td>Bakery</td>
                    <td>Bread and flour products</td>
                    <td>
                        <button>Edit</button>
