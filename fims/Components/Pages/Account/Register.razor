@page "/register"
@layout LoginLayout

@using Microsoft.AspNetCore.Identity
@using fims.Models.ViewModels
@inject UserManager<ApplicationUser> UserManager



<main>
    <section class="register-card">
        <h2>Create an Account</h2>

        <EditForm Model="Model"
            OnValidSubmit="HandleRegister">

            <input
                type="text"
                @bind="Model.FullName"
                placeholder="full name"
                required
            >

            <input
                type="email"
                @bind="Model.Email"
                placeholder="email"
                required
            >

            <input
                type="password"
                @bind="Model.Password"
                placeholder="password"
                required
            >

            <input
                type="password"
                @bind="Model.ConfirmPassword"
                placeholder="confirm password"
                required
            >

            <button type="submit">
                Register
            </button>

            <DataAnnotationsValidator />

            <ValidationSummary />
        </EditForm>

        <a href="/login">Already have an account? Log in</a>

        <p>role assigned by admin at signup</p>

    </section>
</main>

@code {
    private RegisterViewModel Model = new();

    private async Task HandleRegister()

    {

    }

}
