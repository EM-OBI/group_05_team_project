@page "/register"
@rendermode InteractiveServer
@layout LoginLayout

@using fims.Models
@using fims.Models.ViewModels

@inject NavigationManager Navigation
@inject IJSRuntime JS

<main>

    <section class="register-card">

        <h2>Create an Account</h2>

        <EditForm Model="@Model"
                  OnValidSubmit="HandleRegister"
                  FormName="RegisterForm">

            <DataAnnotationsValidator />
            <ValidationSummary />

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="alert alert-danger">
                    @ErrorMessage
                </div>
            }

            <InputText
                @bind-Value="Model.FullName"
                placeholder="Full Name"
                class="form-control" />

            <InputText
                @bind-Value="Model.Email"
                placeholder="Email"
                class="form-control"
                type="email" />

            <InputText
                @bind-Value="Model.Password"
                placeholder="Password"
                class="form-control"
                type="password" />

            <InputText
                @bind-Value="Model.ConfirmPassword"
                placeholder="Confirm Password"
                class="form-control"
                type="password" />

            <div class="form-buttons">
                <button class="btn btn-secondary" type="button" @onclick="HandleCancel">
                    Cancel
                </button>
                <button class="btn btn-primary" type="submit">
                    Register
                </button>
            </div>
        </EditForm>

        <a href="/login">
            Already have an account?
        </a>
    </section>
</main>

@code {
    private RegisterViewModel Model = new();

    private string ErrorMessage = string.Empty;

    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/auth.js");
        }
    }

    private async Task HandleRegister()
    {
        ErrorMessage = string.Empty;

        if (_module is null)
        {
            ErrorMessage = "Registration is not ready yet. Please try again.";
            return;
        }

        try
        {
            var result = await _module.InvokeAsync<AuthResponse>("postJson", "/api/auth/register", new
            {
                FullName = Model.FullName,
                Email = Model.Email,
                Password = Model.Password,
                ConfirmPassword = Model.ConfirmPassword
            });

            if (result != null && result.Ok)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            var message = result?.Data?.message;
            ErrorMessage = string.IsNullOrWhiteSpace(message)
                ? "Registration failed. Please check your information."
                : message;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"An error occurred: {ex.Message}";
        }
    }

    private void HandleCancel()
    {
        Navigation.NavigateTo("/");
    }

    private class AuthResponse
    {
        public bool Ok { get; set; }
        public AuthData? Data { get; set; }
    }

    private class AuthData
    {
        public string? redirectUrl { get; set; }
        public string? message { get; set; }
    }
}
