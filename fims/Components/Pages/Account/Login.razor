@page "/login"
@layout LoginLayout
@using fims.Models.ViewModels
@inject NavigationManager Nav



<main>
    <section class="login-card">
        <h2>Inventory App</h2>

        <EditForm Model="Model" OnValidSubmit="HandleLogin">
            <input
                type="email"
                @bind="Model.Email"
                placeholder="email"
                required
            >

            <input
                type="password"
                @bind="Model.Password"
                placeholder="password"
                required
            >

            <div class="form-buttons">
                <button type="button" class="btn-cancel" @onclick="HandleCancel">
                    Cancel
                </button>
                <button type="submit">
                    Log In
                </button>
            </div>
            <DataAnnotationsValidator />
            <ValidationSummary />
        </EditForm>

        <a href="/register">Create an account</a>

        <p>role assigned by admin at signup</p>
    </section>
</main>

@code {
    private LoginViewModel Model = new();
    private void HandleLogin()
    {
    }

    private void HandleCancel()
    {
        Nav.NavigateTo("/");
    }
}
