@page "/login"
@rendermode InteractiveServer

@layout LoginLayout

@using fims.Models
@using fims.Models.ViewModels

@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Login | FIMS Inventory</PageTitle>

<main>

    <section class="login-card">

        <h2>FIMS Inventory App</h2>

        <EditForm Model="@Model"
                  OnValidSubmit="HandleLogin"
                  FormName="LoginForm">

            <DataAnnotationsValidator />
            <ValidationSummary />

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="alert alert-danger">
                    @ErrorMessage
                </div>
            }

            <label>Email: 
                <InputText
                    @bind-Value="Model.Email"
                    type="email"
                    class="form-control"
                    placeholder="Email" />
            </label>

            <label>Password:
                <InputText
                    @bind-Value="Model.Password"
                    type="password"
                    class="form-control"
                    placeholder="Password" />
            </label>

            <div class="form-check mt-2 mb-3">
                <label>Remember Me:
                    <InputCheckbox @bind-Value="Model.RememberMe" />
                </label>
            </div>

            <div class="form-buttons">
                <button class="btn btn-secondary" type="button" @onclick="HandleCancel">
                    Cancel
                </button>
                <button class="btn btn-primary" type="submit">
                    Login
                </button>
            </div>
        </EditForm>

        <a href="/register" class="darker-text">
            Create an account
        </a>
        <a href="/" class="darker-text">
            Return home
        </a>
    </section>
</main>

@code {
    private LoginViewModel Model = new();

    private string ErrorMessage = string.Empty;

    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/auth.js");
        }
    }

    private async Task HandleLogin()
    {
        ErrorMessage = string.Empty;

        if (_module is null)
        {
            ErrorMessage = "Login is not ready yet. Please try again.";
            return;
        }

        try
        {
            var result = await _module.InvokeAsync<AuthResponse>("postJson", "/api/auth/login", new
            {
                Email = Model.Email,
                Password = Model.Password,
                RememberMe = Model.RememberMe
            });

            if (result != null && result.Ok)
            {
                var redirectUrl = result.Data?.redirectUrl ?? "/";
                Navigation.NavigateTo(redirectUrl, forceLoad: true);
                return;
            }

            var message = result?.Data?.message;
            ErrorMessage = string.IsNullOrWhiteSpace(message)
                ? "Invalid email or password. Please try again."
                : message;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"An error occurred: {ex.Message}";
        }
    }

    private void HandleCancel()
    {
        Navigation.NavigateTo("/");
    }

    private class AuthResponse
    {
        public bool Ok { get; set; }
        public AuthData? Data { get; set; }
    }

    private class AuthData
    {
        public string? redirectUrl { get; set; }
        public string? message { get; set; }
    }
}
