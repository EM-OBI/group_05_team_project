@page "/dashboard"

<main>

    <section class="cards">

        <div class="card">
            <h4>Total Products</h4>
            <h2>248</h2>
        </div>

        <div class="card">
            <h4>Stock Value</h4>
            <h2>$12,400</h2>
        </div>

        <div class="card warning">
            <h4>Low Stock Items</h4>
            <h2>6</h2>
        </div>

    </section>

    <section class="alerts">

        <h3>Low Stock Alerts</h3>

        <table>

            <tr>
                <td>Your Mug</td>
                <td>Stock: 3</td>
                <td>Min: 10</td>
                <td><button>Restock</button></td>
            </tr>

            <tr>
                <td>Sugar Bag</td>
                <td>Stock: 1</td>
                <td>Min: 5</td>
                <td><button>Restock</button></td>
            </tr>

            <tr>
                <td>Rice</td>
                <td>Stock: 2</td>
                <td>Min: 10</td>
                <td><button>Restock</button></td>
            </tr>

        </table>

    </section>

</main>
