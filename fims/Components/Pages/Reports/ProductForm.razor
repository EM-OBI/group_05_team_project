@page "/reports/product-form"
@page "/product-form"
@attribute [Authorize]
@rendermode InteractiveServer
@inject AppDbContext Db
@implements IDisposable

<main>

    <section class="form-card">

        <h2>Add / Edit Product</h2>

        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="status-message @(statusIsError ? "error" : "success")">@statusMessage</div>
        }

        <form @onsubmit="HandleSubmit" @formname="ProductForm">

            <div class="row">

                <div class="field">
                    <label>Product Name</label>
                    <input type="text" @bind="ProductName">
                </div>

                <div class="field">
                    <label>SKU</label>
                    <input type="text" @bind="Sku">
                </div>

            </div>

            <div class="row">

                <div class="field">
                    <label>Category</label>
                    <select @bind="CategoryId">
                        <option value="0">Select Category</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.CategoryId">@cat.Name</option>
                        }
                    </select>
                </div>

                <div class="field">
                    <label>Supplier</label>
                    <select @bind="SupplierId">
                        <option value="0">Select Supplier</option>
                        @foreach (var sup in suppliers)
                        {
                            <option value="@sup.SupplierId">@sup.Name</option>
                        }
                    </select>
                </div>

            </div>

            <div class="row">

                <div class="field">
                    <label>Price</label>
                    <input type="number" step="0.01" @bind="Price">
                </div>

                <div class="field">
                    <label>Current Stock</label>
                    <input type="number" @bind="CurrentStock">
                </div>

            </div>

            <div class="row">

                <div class="field">
                    <label>Minimum Stock</label>
                    <input type="number" @bind="MinimumStock">
                </div>

                <div class="field">
                    <label>Unit</label>
                    <select @bind="Unit">
                        <option>Units</option>
                        <option>Kg</option>
                        <option>Liters</option>
                    </select>
                </div>

            </div>

            <div class="field">

                <label>Description</label>

                <textarea rows="5" @bind="Description"></textarea>

            </div>

            <div class="buttons">

                <button class="cancel" type="button" @onclick="HandleCancel">
                    Cancel
                </button>

                <button class="save" type="submit">
                    Save Product
                </button>

            </div>

        </form>

    </section>

</main>

@code {
    [SupplyParameterFromQuery]
    public int? ProductId { get; set; }

    private List<Category> categories = new();
    private List<Supplier> suppliers = new();

    private string ProductName { get; set; } = string.Empty;
    private string Sku { get; set; } = string.Empty;
    private int CategoryId { get; set; }
    private int SupplierId { get; set; }
    private decimal Price { get; set; }
    private int CurrentStock { get; set; }
    private int MinimumStock { get; set; }
    private string Unit { get; set; } = "Units";
    private string Description { get; set; } = string.Empty;
    private string statusMessage = string.Empty;
    private bool statusIsError;
    private System.Threading.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        categories = await Db.Categories.ToListAsync();
        suppliers = await Db.Suppliers.ToListAsync();

        if (ProductId.HasValue)
        {
            var product = await Db.Products.FindAsync(ProductId.Value);
            if (product != null)
            {
                ProductName = product.Name;
                Sku = product.Description ?? "";
                CategoryId = product.CategoryId;
                SupplierId = product.SupplierId;
                Price = product.Price;
                CurrentStock = product.CurrentStockQuantity;
                MinimumStock = product.MinimumStockThreshold;
                Description = product.Description ?? "";
            }
        }
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(ProductName))
        {
            statusMessage = "Product name is required.";
            statusIsError = true;
            return;
        }
        if (CategoryId == 0)
        {
            statusMessage = "Please select a category.";
            statusIsError = true;
            return;
        }
        if (SupplierId == 0)
        {
            statusMessage = "Please select a supplier.";
            statusIsError = true;
            return;
        }

        try
        {
            if (ProductId.HasValue)
            {
                var product = await Db.Products.FindAsync(ProductId.Value);
                if (product == null)
                {
                    statusMessage = "Product not found.";
                    statusIsError = true;
                    return;
                }
                product.Name = ProductName.Trim();
                product.Description = string.IsNullOrWhiteSpace(Description) ? null : Description.Trim();
                product.CategoryId = CategoryId;
                product.SupplierId = SupplierId;
                product.Price = Price;
                product.CurrentStockQuantity = CurrentStock;
                product.MinimumStockThreshold = MinimumStock;
            }
            else
            {
                Db.Products.Add(new Product
                {
                    Name = ProductName.Trim(),
                    Description = string.IsNullOrWhiteSpace(Description) ? null : Description.Trim(),
                    CategoryId = CategoryId,
                    SupplierId = SupplierId,
                    Price = Price,
                    CurrentStockQuantity = CurrentStock,
                    MinimumStockThreshold = MinimumStock
                });
            }

            await Db.SaveChangesAsync();
            statusMessage = "Product saved successfully.";
            statusIsError = false;

            ClearForm();
            StartAutoHide();
        }
        catch (Exception ex)
        {
            statusMessage = $"Error saving product: {ex.Message}";
            statusIsError = true;
        }
    }

    private void ClearForm()
    {
        ProductName = "";
        Sku = "";
        CategoryId = 0;
        SupplierId = 0;
        Price = 0;
        CurrentStock = 0;
        MinimumStock = 0;
        Unit = "Units";
        Description = "";
    }

    private void HandleCancel()
    {
        ClearForm();
        statusMessage = "";
        _timer?.Dispose();
    }

    private void StartAutoHide()
    {
        _timer?.Dispose();
        _timer = new System.Threading.Timer(async _ =>
        {
            statusMessage = "";
            await InvokeAsync(StateHasChanged);
            _timer?.Dispose();
            _timer = null;
        }, null, 3000, System.Threading.Timeout.Infinite);
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
